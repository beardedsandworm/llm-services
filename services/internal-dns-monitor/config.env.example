# Copy to /etc/internal-dns-monitor/config.env and fill LAN-specific values.
# A blank RESOLVER_SERVERS observes the ordinary client's /etc/resolv.conf.
RESOLVER_SERVERS=
EXPECTED_RESOLVERS=
PIHOLE_SERVERS=
CHECK_DOMAIN=example.com
# Choose a domain known to be blocked by the Pi-hole policy.
BLOCK_DOMAIN=use-application-dns.net
# Optional. A random label is prepended, then queried only through Pi-hole.
# This intentionally never targets Midway directly from an IX client.
FRESH_RECURSION_SUFFIX=
# Optional GET target for ordinary operations-plane reachability.
OPS_HEALTH_URL=
# Required before current observations can be POSTed to n8n correlation.
OBSERVATION_INGRESS_URL=
# Existing centrally materialized Header-Auth token; this service never owns it.
OPS_TOKEN_FILE=/srv/ix/llm-services/runtime/server02/secrets/leto_ops_ingress_token
# Optional override; defaults are the local hostname and ordinary-lan-client.
EXECUTION_HOST=
VANTAGE=ordinary-lan-client
STATE_FILE=/var/lib/internal-dns-monitor/state.json
CONTINGENCY_FAILURE_THRESHOLD=3
